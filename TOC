  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@100;300;400;500;600;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      /* Avon palette */
      --power-pink: #E5004B;
      --light-pink: #FFF4F7;
      --coral: #F66F7C;
      --soft-coral: #FFAEB1;
      --dark-blue: #0060AC;
      --mid-blue: #3096E2;
      --pale-blue: #97BCDF;

      --bg: #FFFFFF;
      --surface: #FFFFFF;
      --border: rgba(0,0,0,0.08);
      --border-hover: rgba(0,0,0,0.15);
      --text-primary: #000000;
      --text-secondary: #4A5568;
      --text-tertiary: #718096;

      /* UK column = Power Pink family */
      --uk-light: var(--light-pink);
      --uk-mid: var(--coral);
      --uk-strong: var(--power-pink);

      /* Omni column = Blue family */
      --oc-light: #EAF3FB;
      --oc-mid: var(--mid-blue);
      --oc-strong: var(--dark-blue);

      --radius-md: 8px;
      --radius-lg: 12px;
      --radius-xl: 16px;
    }

    body {
      font-family: 'Lato', Calibri, Arial, sans-serif;
      background: var(--bg);
      color: var(--text-primary);
      min-height: 100vh;
      padding: 3rem 2rem;
    }

    .page-wrapper {
      max-width: 860px;
      margin: 0 auto;
    }

    /* Brand chrome */
    .brand-row {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 1.75rem;
    }
    .brandmark {
      width: 56px;
      height: 56px;
      flex: 0 0 auto;
      display: block;
    }
    .hub-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
    .hub-title {
      font-size: 22px;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--text-primary);
      text-align: right;
      line-height: 1.25;
    }
    .brand-strap {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--text-secondary);
    }

    /* Header */
    .page-header {
      margin-bottom: 2.5rem;
    }
    .page-eyebrow {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--power-pink);
      margin-bottom: 8px;
    }
    .page-title {
      font-size: 30px;
      font-weight: 400;
      text-transform: uppercase;
      color: var(--text-primary);
      letter-spacing: 0.02em;
      margin-bottom: 8px;
    }
    .page-sub {
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.6;
    }
    .header-rule {
      margin-top: 0.75rem;
      border: none;
      border-top: 1px solid rgba(0,0,0,0.16);
    }
    .load-note {
      margin-top: 10px;
      font-size: 11.5px;
      color: var(--text-tertiary);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .load-note i { font-size: 13px; }

    .priority-link {
      display: flex;
      align-items: center;
      gap: 12px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-left: 3px solid var(--power-pink);
      border-radius: var(--radius-lg);
      padding: 14px 18px;
      margin-bottom: 2rem;
      text-decoration: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }
    .priority-link:hover {
      border-color: var(--uk-mid);
      box-shadow: 0 4px 16px rgba(229,0,75,0.10);
      transform: translateY(-2px);
    }
    .priority-link .card-icon {
      margin-bottom: 0;
      background: var(--light-pink);
      flex: 0 0 auto;
    }
    .priority-link .card-icon i { color: var(--power-pink); }
    .priority-link-text { display: flex; flex-direction: column; }
    .priority-link-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-primary);
    }
    .priority-link-sub {
      font-size: 11.5px;
      color: var(--text-tertiary);
      margin-top: 2px;
    }

    /* Two-column layout */
    .col-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    @media (max-width: 600px) {
      .col-grid { grid-template-columns: 1fr; }
    }

    /* Column header */
    .col-label-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 14px;
    }
    .col-label-icon {
      width: 24px; height: 24px;
      border-radius: var(--radius-md);
      display: flex; align-items: center; justify-content: center;
      font-size: 13px;
    }
    .col-uk .col-label-icon { background: var(--uk-light); color: var(--uk-strong); }
    .col-omni .col-label-icon { background: var(--oc-light); color: var(--oc-strong); }
    .col-label-text {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    /* Card grid (2 per row within each column) */
    .card-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    /* Card */
    .toc-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1rem;
      cursor: pointer;
      text-decoration: none;
      display: block;
      position: relative;
      overflow: hidden;
      transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }
    .toc-card::after {
      content: '';
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.25s ease;
      pointer-events: none;
      border-radius: inherit;
    }
    .toc-card:hover {
      transform: translateY(-3px);
    }
    .toc-card:active {
      transform: translateY(0) scale(0.98);
    }
    .toc-card:focus-visible {
      outline: 2px solid var(--power-pink);
      outline-offset: 2px;
    }

    /* UK hover (Power Pink) */
    .col-uk .toc-card::after {
      background: linear-gradient(140deg, rgba(229,0,75,0.06) 0%, transparent 65%);
    }
    .col-uk .toc-card:hover {
      border-color: var(--uk-mid);
      box-shadow: 0 4px 16px rgba(229,0,75,0.12);
    }
    .col-uk .toc-card:hover::after { opacity: 1; }
    .col-uk .toc-card:hover .card-icon { background: var(--uk-light); }
    .col-uk .toc-card:hover .card-icon i { color: var(--uk-strong); }
    .col-uk .toc-card:hover .card-badge { color: var(--uk-strong); }

    /* Omni hover (Blue) */
    .col-omni .toc-card::after {
      background: linear-gradient(140deg, rgba(0,96,172,0.06) 0%, transparent 65%);
    }
    .col-omni .toc-card:hover {
      border-color: var(--oc-mid);
      box-shadow: 0 4px 16px rgba(0,96,172,0.12);
    }
    .col-omni .toc-card:hover::after { opacity: 1; }
    .col-omni .toc-card:hover .card-icon { background: var(--oc-light); }
    .col-omni .toc-card:hover .card-icon i { color: var(--oc-strong); }
    .col-omni .toc-card:hover .card-badge { color: var(--oc-strong); }

    /* Card internals */
    .card-icon {
      width: 32px; height: 32px;
      border-radius: var(--radius-md);
      background: #F4F4F2;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 10px;
      transition: background 0.2s;
    }
    .card-icon i {
      font-size: 16px;
      color: var(--text-tertiary);
      transition: color 0.2s;
    }
    /* Icon tile holding a report thumbnail image */
    .card-icon.card-icon--img {
      background: none;
      padding: 0;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .card-icon.card-icon--img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .card-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 3px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .card-sub {
      font-size: 11px;
      color: var(--text-tertiary);
      line-height: 1.4;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .card-badge {
      font-size: 10px;
      font-weight: 600;
      margin-top: 10px;
      color: var(--text-tertiary);
      transition: color 0.2s;
    }
    .card-date {
      font-size: 10px;
      font-weight: 500;
      margin-top: 2px;
      color: var(--text-tertiary);
      opacity: 0.75;
    }

    /* Placeholder dimming */
    .placeholder .card-title { color: var(--text-tertiary); font-weight: 600; }
    .placeholder .card-icon i { color: #CCCCCC; }

    /* Browser hint banner */
    .browser-hint {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--light-pink);
      border: 1px solid rgba(229,0,75,0.18);
      border-left: 3px solid var(--power-pink);
      border-radius: var(--radius-md);
      padding: 10px 14px;
      margin-bottom: 1.75rem;
    }
    .browser-hint i {
      font-size: 16px;
      color: var(--power-pink);
      flex: 0 0 auto;
    }
    .browser-hint span {
      font-size: 12px;
      color: var(--text-secondary);
      line-height: 1.5;
    }
    .browser-hint strong {
      color: var(--text-primary);
      font-weight: 700;
    }

    /* Footer */
    .page-footer {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .footer-text {
      font-size: 11px;
      color: var(--text-tertiary);
    }
    .footer-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--power-pink);
      opacity: 0.5;
    }
  </style>
</head>
